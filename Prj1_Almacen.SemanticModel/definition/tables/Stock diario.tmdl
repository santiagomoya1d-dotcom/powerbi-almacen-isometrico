	partition 'Stock diario' = m
		mode: import
		source =
				let
				    Origen = Csv.Document(File.Contents(CarpetaDatos & "StockDiario.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Encabezados = Table.PromoteHeaders(Origen, [PromoteAllScalars = true]),
				    SinVacios = Table.ReplaceValue(Encabezados, "", null, Replacer.ReplaceValue, Table.ColumnNames(Encabezados)),
				    Tipos = Table.TransformColumnTypes(SinVacios, {{"Fecha", type date}, {"SKU", type text}, {"Stock final (palets)", Int64.Type}, {"Entradas (palets)", Int64.Type}, {"Demanda (palets)", Int64.Type}, {"Servidos (palets)", Int64.Type}, {"No servidos (palets)", Int64.Type}, {"Edad media (días)", type number}, {"Valor stock (€)", Int64.Type}}, "en-US")
				in
				    Tipos

