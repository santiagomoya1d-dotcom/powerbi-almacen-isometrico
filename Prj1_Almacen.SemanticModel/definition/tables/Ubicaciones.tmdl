	partition Ubicaciones = m
		mode: import
		source =
				let
				    Origen = Csv.Document(File.Contents(CarpetaDatos & "Ubicaciones.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Encabezados = Table.PromoteHeaders(Origen, [PromoteAllScalars = true]),
				    SinVacios = Table.ReplaceValue(Encabezados, "", null, Replacer.ReplaceValue, Table.ColumnNames(Encabezados)),
				    Tipos = Table.TransformColumnTypes(SinVacios, {{"UbicacionID", type text}, {"Pasillo", type text}, {"Orden pasillo", Int64.Type}, {"Hueco", Int64.Type}, {"Nivel", Int64.Type}, {"Posición", Int64.Type}, {"ZonaID", type text}, {"X", type number}, {"Y", type number}, {"Z", type number}}, "en-US")
				in
				    Tipos

