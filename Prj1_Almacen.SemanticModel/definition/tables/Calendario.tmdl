				    Tipos = Table.TransformColumnTypes(SinVacios, {{"Fecha", type date}, {"Año", Int64.Type}, {"Mes", Int64.Type}, {"Nombre del mes", type text}, {"Mes corto", type text}, {"Año-mes", Int64.Type}, {"Mes y año", type text}, {"Trimestre", type text}, {"Semana ISO", Int64.Type}, {"Día", Int64.Type}, {"Día de la semana", type text}, {"Orden día semana", Int64.Type}, {"Abierto", type text}, {"Festivo", type text}, {"Temporada", type text}}, "en-US")
				in
